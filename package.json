{
  "name": "sprintmobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "build:apk": "eas build --platform android --profile production",
    "build:apk:preview": "eas build --platform android --profile preview",
    "build:apk:local": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.1",
    "eslint-config-expo": "~55.0.1",
    "expo": "~55.0.31",
    "expo-battery": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
